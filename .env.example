# Copy to .env.local and fill in. Never commit real values.
# With the two NEXT_PUBLIC_SUPABASE_* values empty, the app runs in demo mode on mock data.

# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the WhatsApp webhook and scheduled jobs (Phase 2+).
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Phase 3) ---
# Without a key, WhatsApp runs in basic mode (simple command patterns, same tools).
OPENAI_API_KEY=
# Optional. Any chat-completions model with tool calling; defaults to gpt-4.1-mini.
OPENAI_MODEL=

# --- WhatsApp Cloud API (Phase 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings > Basic). Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Optional: the agent's number in international format, used by "Ask Agent" links.
NEXT_PUBLIC_WHATSAPP_AGENT_NUMBER=

# --- Google Calendar (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NEXT_PUBLIC_APP_URL=http://localhost:3000
