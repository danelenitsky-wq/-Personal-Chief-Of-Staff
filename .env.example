# Copy to .env.local and fill in. Never commit real values.
# With the two NEXT_PUBLIC_SUPABASE_* values empty, the app runs in demo mode on mock data.

# --- Supabase (Phase 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the WhatsApp webhook and scheduled jobs (Phase 2+).
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Phase 3) ---
OPENAI_API_KEY=

# --- WhatsApp Cloud API (Phase 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: the agent's number in international format, used by "Ask Agent" links.
NEXT_PUBLIC_WHATSAPP_AGENT_NUMBER=

# --- Google Calendar (Phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NEXT_PUBLIC_APP_URL=http://localhost:3000
